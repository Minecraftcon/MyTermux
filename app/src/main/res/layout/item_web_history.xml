<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="?android:attr/selectableItemBackground"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <!-- Globe Icon Container -->
    <FrameLayout
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_webview_info_fab"
        android:layout_marginEnd="14dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_lucide_globe"
            app:tint="@android:color/white"
            android:contentDescription="@null" />
    </FrameLayout>

    <!-- Title and URL -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/history_item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Vite React Dashboard" />

        <TextView
            android:id="@+id/history_item_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="#77FFFFFF"
            android:textSize="12sp"
            tools:text="http://localhost:8080/dashboard" />
    </LinearLayout>

    <!-- Time and Delete -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:layout_marginStart="8dp">

        <TextView
            android:id="@+id/history_item_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#55FFFFFF"
            android:textSize="11sp"
            tools:text="4:30 PM" />

        <ImageButton
            android:id="@+id/history_item_delete_btn"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_webview_btn_ripple"
            android:src="@drawable/ic_lucide_x"
            android:padding="8dp"
            android:scaleType="fitCenter"
            app:tint="#66FFFFFF"
            android:contentDescription="Delete entry" />
    </LinearLayout>

</LinearLayout>
