<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/black"
    android:fitsSystemWindows="true">

    <!-- Top App Bar / Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/web_history_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:title="Browsing History"
        app:titleTextColor="@android:color/white"
        app:navigationIcon="?attr/homeAsUpIndicator" />

    <!-- Search Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginHorizontal="14dp"
        android:layout_marginVertical="10dp"
        android:background="@drawable/bg_webview_url_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_lucide_globe"
            app:tint="#88FFFFFF"
            android:contentDescription="@null" />

        <EditText
            android:id="@+id/web_history_search_input"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Search history..."
            android:textColorHint="#66FFFFFF"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:singleLine="true"
            android:imeOptions="actionSearch"
            android:layout_marginStart="8dp" />

        <ImageButton
            android:id="@+id/web_history_clear_search_btn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_webview_btn_ripple"
            android:src="@drawable/ic_lucide_x"
            android:padding="8dp"
            android:scaleType="fitCenter"
            app:tint="#88FFFFFF"
            android:visibility="gone"
            android:contentDescription="Clear search" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- History Items List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/web_history_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="16dp"
            tools:listitem="@layout/item_web_history" />

        <!-- Empty State View -->
        <LinearLayout
            android:id="@+id/web_history_empty_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_lucide_globe"
                app:tint="#44FFFFFF"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="No Browsing History"
                android:textColor="@android:color/white"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Visited web pages will appear here"
                android:textColor="#88FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

    </FrameLayout>

</LinearLayout>
